# Copy to .env and fill in. Both values are safe to ship in the client bundle:
# the anon key is a public key, and the LLM key never leaves the Edge Function.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The LLM key is NOT read from here. Set it on the Edge Function instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
