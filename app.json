{
  "expo": {
    "name": "RoomRoast",
    "slug": "roomroast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0A0F",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "RoomRoast films a short clip of your room so it can be roasted. The video never leaves your phone.",
        "NSMicrophoneUsageDescription": "Required by the camera to record video. Audio is muted and never captured."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-video"]
  }
}
